# Tebex Headless public token (Tebex → Integrations → Headless API → Public token).
# Empty = preview mode with placeholder products.
NEXT_PUBLIC_TEBEX_TOKEN=

# Tebex secret key (Tebex → Integrations → Game servers → secret key). Server-side only.
# Powers the real "recent purchases" popup and the "Top customer" card.
# Without it, both are hidden on the live store.
TEBEX_SECRET_KEY=

# Public URL of the deployed store (SEO / Open Graph).
NEXT_PUBLIC_SITE_URL=https://torqcustoms.com
